{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks-handlers/session_start.py\"" }
    ],
    "beforeShellExecution": [
      { "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks-handlers/device_gate.py\"", "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks-handlers/device_gate.py\"", "failClosed": true }
    ],
    "postToolUse": [
      { "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks-handlers/post_write_validate.py\" --host cursor", "matcher": "Write|Edit|MultiEdit|StrReplace", "timeout": 90 }
    ]
  }
}
