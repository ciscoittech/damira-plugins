! Damira golden template: aaa_tacacs (cisco_nxos)
! Keep a local user with role network-admin as the fallback before applying.
! The automation account needs a TACACS+ command set on the server BEFORE this is pushed:
! command authorization is last because it applies to the pushing session at once.
feature tacacs+
{% for s in servers %}
tacacs-server host {{ s.address }} key 0 {{ key }} timeout 5
{% endfor %}
aaa group server tacacs+ {{ group }}
{% for s in servers %}
  server {{ s.address }}
{% endfor %}
{% if vrf is defined %}
  use-vrf {{ vrf }}
{% endif %}
{% if source_interface is defined %}
  source-interface {{ source_interface }}
{% endif %}
aaa authentication login default group {{ group }}
aaa accounting default group {{ group }}
aaa authorization config-commands default group {{ group }} local
aaa authorization commands default group {{ group }} local
