{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks-handlers/session_start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|BashOutput|mcp__.*damira.*__(ssh_command|network_device_command)|mcp__.*([Aa][Nn][Ss][Ii][Bb][Ll][Ee]|[Aa][Aa][Pp]|[Aa][Ww][Xx]|[Pp][Yy][Aa][Tt][Ss]|[Gg][Ee][Nn][Ii][Ee]|[Tt][Ee][Rr][Rr][Aa][Ff][Oo][Rr][Mm]|[Oo][Pp][Ee][Nn][Tt][Oo][Ff][Uu]).*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks-handlers/device_gate.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks-handlers/document_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks-handlers/post_write_validate.py",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
