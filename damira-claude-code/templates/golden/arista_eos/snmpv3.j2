! Damira golden template: snmpv3 (arista_eos)
snmp-server group {{ group }} v3 priv
snmp-server user {{ user }} {{ group }} v3 auth sha {{ auth_pass }} priv aes {{ priv_pass }}
snmp-server enable traps
{% for host in hosts %}
snmp-server host {{ host }}{% if vrf is defined %} vrf {{ vrf }}{% endif %} version 3 priv {{ user }}
{% endfor %}
snmp-server location {{ location }}
snmp-server contact {{ contact }}
